{
  "name": "auth-service",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "db:migrate": "cd ../prisma && npx prisma migrate dev --schema=./schema.prisma",
    "db:generate": "cd ../prisma && npx prisma generate --schema=./schema.prisma",
    "db:studio": "cd ../prisma && npx prisma studio --schema=./schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "express": "^4.18.2",
    "bcryptjs": "^2.4.3", 
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "prisma": "^5.10.2",
    "nodemon": "^3.0.1"
  }
}