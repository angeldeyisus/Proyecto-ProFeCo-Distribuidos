    "mongoose": "^9.0.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.10.2"
  },
  "description": "Proyecto final ProFeCo para la clase de Sistemas Distribuidos desarrollado por Angel Santos y Christopher Elizalde",
