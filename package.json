{
  "name": "proyecto-profeco-distribuidos",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "db:migrate": "cd ../prisma && npx prisma migrate dev --schema=./schema.prisma",
    "db:generate": "cd ../prisma && npx prisma generate --schema=./schema.prisma",
    "db:studio": "cd ../prisma && npx prisma studio --schema=./schema.prisma"
  },
